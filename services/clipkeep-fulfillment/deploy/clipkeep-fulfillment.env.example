# Copy to /etc/clipkeep-fulfillment.env, then: chown root:clipkeep and chmod 640.
HOST=127.0.0.1
PORT=3202

# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe Dashboard -> Payment links -> the ClipKeep link; the id starts with plink_.
CLIPKEEP_PAYMENT_LINK_ID=plink_replace_me

# Generate with: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=replace_with_64_hex_characters
DOWNLOAD_FILE=/srv/clipkeep/ClipKeep.dmg
DOWNLOAD_FILENAME=ClipKeep.dmg
DOWNLOAD_LINK_DAYS=14
PUBLIC_BASE_URL=https://downloads.soheililabs.com

# Resend: an API key, and a From address on a domain verified in Resend.
RESEND_API_KEY=re_replace_me
FULFILLMENT_FROM_EMAIL=ClipKeep <clipkeep@soheililabs.com>
SUPPORT_EMAIL=support@soheililabs.com
# Optional: get an email for every sale.
NOTIFY_EMAIL=
